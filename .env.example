# Öffentlich im Browser
VITE_PUBLIC_SITE_URL=
VITE_TURNSTILE_SITE_KEY=

# Nur serverseitig in Netlify Functions
PUBLIC_SITE_URL=
TURNSTILE_SECRET_KEY=

# Temporärer Speicherbetrieb: netlify (max. 20 MB pro Datei) oder hetzner
MEDIA_STORAGE=hetzner
VITE_MEDIA_STORAGE=hetzner

HETZNER_S3_REGION=nbg1
HETZNER_S3_ENDPOINT=https://nbg1.your-objectstorage.com
HETZNER_S3_BUCKET=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

ADMIN_PIN_HASH=
SESSION_SECRET=

# Optional: lokale/CI-Tests ohne externe Dienste. In Produktion nie aktivieren.
ALLOW_TEST_BYPASS=false
